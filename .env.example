# Kinyarwanda AI Assistant Configuration

# App Settings
APP_NAME=Kinyarwanda AI Assistant
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Language
LANGUAGE=kinyarwanda
TTS_ENGINE=pyttsx3

# Hardware Limits (for 2GB RAM systems)
MAX_MEMORY_MB=400
MAX_THREADS=2
POLLING_INTERVAL=5

# Monitoring
ENABLE_SCREEN_MONITORING=True
ENABLE_FILE_MONITORING=True
ENABLE_ACTIVITY_TRACKING=True

# Learning
AUTO_LEARN=True
LEARNING_INTERVAL=3600

# Database
DB_PATH=data/assistant.db
DB_BACKUP=True

# Features
ENABLE_NOTIFICATIONS=True
ENABLE_SUGGESTIONS=True
ENABLE_VOICE_COMMANDS=True

# System Control
ALLOW_SYSTEM_SHUTDOWN=True
ALLOW_APP_CLOSING=True
ALLOW_SCREEN_CONTROL=True

# Paths
DATA_DIR=data
LOG_DIR=logs
MODELS_DIR=data/models
CACHE_DIR=data/cache
